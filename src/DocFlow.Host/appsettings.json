{
  "ConnectionStrings": {
    "DocFlow": "Host=localhost;Port=5432;Database=docflow;Username=docflow;Password=docflow"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "Engine": {
    "PollIntervalSeconds": 15,
    "SignalScanIntervalSeconds": 15,
    "RunnerIntervalSeconds": 3,
    "MaxAttempts": 3,
    "RetryBaseDelaySeconds": 30,
    "MaxParallelProcesses": 4
  },
  "Storage": {
    "WorkingDir": "./data/work",
    "Types": {
      "zop":     { "SignInputDir": "./data/zop/sign-input", "SignResultDir": "./data/zop/sign-result", "FinalDir": "./data/zop/final" },
      "report":  { "FinalDir": "./data/report/final" },
      "inbox":   { "FinalDir": "./data/inbox/final" },
      "archive": { "SearchDir": "./data/archive/search", "FinalDir": "./data/archive/final" }
    }
  },
  "Intake": {
    "Directories": [
      { "Name": "inbox", "Path": "./data/in/inbox", "Mask": "*.pdf" }
    ]
  }
}
